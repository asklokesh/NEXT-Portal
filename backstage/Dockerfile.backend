FROM node:20-bookworm-slim

# System deps: sqlite (native module), python (node-gyp), git (clone upstream)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libsqlite3-dev python3 python3-pip python3-venv \
      build-essential curl ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

# mkdocs for TechDocs
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN pip3 install mkdocs-techdocs-core==1.1.7

# Clone upstream Backstage at the pinned tag (shallow, no history)
ARG BACKSTAGE_TAG=v1.42.0-next.1
WORKDIR /build
RUN git clone --depth 1 --branch ${BACKSTAGE_TAG} \
    https://github.com/backstage/backstage.git .

# Apply our overlay: custom backend entrypoint + auth/RBAC modules + configs
# These files are COPY-ed from backstage/ in the build context (the overlay dir)
COPY packages/backend/src/index.ts              packages/backend/src/index.ts
COPY packages/backend/src/rbacPolicy.ts         packages/backend/src/rbacPolicy.ts
COPY packages/backend/src/authModuleGithubProvider.ts packages/backend/src/authModuleGithubProvider.ts
COPY packages/backend/src/instanceMetadata.ts   packages/backend/src/instanceMetadata.ts
COPY packages/backend/src/instrumentation.js    packages/backend/src/instrumentation.js
COPY app-config.yaml                            app-config.yaml
COPY app-config.docker.yaml                     app-config.docker.yaml

RUN chown -R node:node /build && mkdir -p /app/runtime && chown -R node:node /app
USER node

# Install workspace deps (GIT_SSL_NO_VERIFY for any git:// transitive deps)
RUN GIT_SSL_NO_VERIFY=true yarn install --immutable

# Build the backend package (produces dist/bundle.tar.gz + dist/skeleton.tar.gz)
RUN NODE_OPTIONS="--max-old-space-size=4096" yarn workspace example-backend build

# Extract the built bundle into a clean runtime directory
RUN cd /app/runtime && \
    tar xzf /build/packages/backend/dist/skeleton.tar.gz && \
    tar xzf /build/packages/backend/dist/bundle.tar.gz && \
    cp /build/app-config.yaml /build/app-config.docker.yaml /app/runtime/ && \
    cp -r /build/.yarn /build/.yarnrc.yml /app/runtime/ 2>/dev/null || true

WORKDIR /app/runtime

RUN yarn workspaces focus --all --production 2>/dev/null || true

EXPOSE 7007
ENV NODE_ENV=development

CMD ["node", "packages/backend", "--config", "app-config.yaml", "--config", "app-config.docker.yaml"]
