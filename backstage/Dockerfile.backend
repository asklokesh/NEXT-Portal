FROM node:20-bookworm-slim

# System deps for native modules and TechDocs
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libsqlite3-dev python3 python3-pip python3-venv \
      build-essential curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# TechDocs generator
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN pip3 install mkdocs-techdocs-core==1.1.7

WORKDIR /app
RUN chown node:node /app
USER node

# Copy yarn berry release and config first (cache layer)
COPY --chown=node:node .yarn ./.yarn
COPY --chown=node:node .yarnrc.yml package.json yarn.lock ./

# Copy all package.json files to resolve workspaces (without source)
COPY --chown=node:node packages/backend/package.json ./packages/backend/
COPY --chown=node:node packages/app/package.json ./packages/app/

# Install all workspace deps
RUN yarn install --immutable

# Copy source
COPY --chown=node:node . .

# Build only the backend package (example-backend)
RUN yarn tsc && yarn workspace example-backend build

EXPOSE 7007

ENV NODE_ENV=production

CMD ["node", "packages/backend", "--config", "app-config.yaml", "--config", "app-config.local.yaml"]
