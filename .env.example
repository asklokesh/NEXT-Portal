# ============================================================================
# NEXT Portal - Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in the values
# Never commit .env.local to version control
# ============================================================================

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=development
PORT=4400
NEXT_PUBLIC_APP_URL=http://localhost:4400

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Development: postgresql://postgres:postgres@localhost:5432/next_portal
# Production: Use managed database service URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_portal

# Optional: Use mock data for development
USE_MOCK_DB=false
USE_MOCK_DATA=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Prefer REDIS_URL in Docker; host/port are auto-derived when URL is set
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_ENABLED=false

# Session Redis (if separate from main Redis)
SESSION_REDIS_HOST=localhost
SESSION_REDIS_PORT=6379
SESSION_REDIS_PASSWORD=
SESSION_REDIS_DB=0

# ============================================================================
# AUTHENTICATION
# ============================================================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:4400
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32

# JWT Configuration
JWT_SECRET=your-jwt-secret-generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Session Secret
SESSION_SECRET=your-session-secret-generate-with-openssl-rand-base64-32

# Encryption key for at-rest sensitive fields (exactly 32 characters)
ENCRYPTION_KEY=dev-encryption-key-32-chars-min!

# ============================================================================
# BILLING (STRIPE)
# ============================================================================
# Required in production. Use Stripe test keys locally; never commit live keys.

STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# ============================================================================
# OAUTH PROVIDERS
# ============================================================================

# GitHub OAuth
# Create at: https://github.com/settings/developers
# Callback: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_ADMIN_USERS=
GITHUB_ADMIN_ORGS=

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Callback: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADMIN_EMAILS=
GOOGLE_ADMIN_DOMAINS=

# Microsoft Azure AD OAuth (Enterprise SSO)
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

NEXT_PUBLIC_WS_URL=ws://localhost:3001
ENABLE_WEBSOCKET=true

# ============================================================================
# INTEGRATIONS - VERSION CONTROL
# ============================================================================

# GitHub
GITHUB_API_URL=https://api.github.com

# GitLab
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# Bitbucket (optional)
BITBUCKET_URL=
BITBUCKET_TOKEN=

# ============================================================================
# INTEGRATIONS - CI/CD
# ============================================================================

# ArgoCD
ARGOCD_URL=
ARGOCD_TOKEN=

# Jenkins
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# ============================================================================
# INTEGRATIONS - PROJECT MANAGEMENT
# ============================================================================

# Jira
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# ============================================================================
# INTEGRATIONS - MONITORING
# ============================================================================

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_QUERY_URL=

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=
GRAFANA_ENABLED=false

# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# New Relic
NEW_RELIC_LICENSE_KEY=

# Sentry
SENTRY_DSN=

# ============================================================================
# INTEGRATIONS - COMMUNICATION
# ============================================================================

# Slack
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ============================================================================
# CLOUD PROVIDERS
# ============================================================================

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Google Cloud
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# ============================================================================
# CDN CONFIGURATION
# ============================================================================

CDN_URL=
CDN_PROVIDER=cloudfront
CDN_BUCKET=
CDN_REGION=us-east-1
CLOUDFRONT_DISTRIBUTION_ID=
NEXT_PUBLIC_CDN_SUPPORTS_OPTIMIZATION=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOGS=true
ENABLE_COST_TRACKING=true
ENABLE_DEPLOYMENTS=true
ENABLE_DEV_FEATURES=true

# ============================================================================
# SECURITY
# ============================================================================

# CORS (comma-separated origins). CORS_ORIGIN is used by middleware; first CORS_ORIGINS entry is accepted as fallback.
CORS_ORIGIN=http://localhost:4400
CORS_ORIGINS=http://localhost:3000,http://localhost:4400

# Rate Limiting
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# CSRF Protection
CSRF_SECRET=your-csrf-secret

# ============================================================================
# LOGGING
# ============================================================================

# Log Level: error, warn, info, debug, trace
LOG_LEVEL=debug
ENABLE_INSTALL_LOGS=true

# ============================================================================
# BACKSTAGE INTEGRATION (Legacy)
# ============================================================================

BACKSTAGE_ROOT=./backstage
BACKSTAGE_API_URL=http://localhost:7007
BACKSTAGE_BACKEND_URL=http://localhost:7007
BACKSTAGE_FRONTEND_URL=http://localhost:3000
BACKSTAGE_API_TOKEN=
BACKSTAGE_AUTH_TOKEN=

# ============================================================================
# PLUGIN MANAGEMENT
# ============================================================================

USE_ENHANCED_INSTALLER=true
PLUGIN_INSTALL_MODE=local
AUTO_RESTART_ENABLED=true
AUTO_UPDATE_CODE=true
NPM_REGISTRY_URL=https://registry.npmjs.org
CREATE_BACKUP_BEFORE_INSTALL=true
BACKUP_DIRECTORY=./backstage-backups

# Timeouts (milliseconds)
NPM_INSTALL_TIMEOUT=300000
BACKSTAGE_RESTART_TIMEOUT=60000
HEALTH_CHECK_TIMEOUT=30000

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================
# Uncomment and configure for production deployments

# FORCE_HTTPS=true
# TRUST_PROXY=true
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# REDIS_POOL_MIN=1
# REDIS_POOL_MAX=5
