# Application Configuration
NODE_ENV=development
PORT=4400
MAIN_APP_PORT=4400
NEXT_PUBLIC_APP_URL=http://localhost:4400

# Database Configuration (matches docker-compose.full.yml postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_portal?schema=public
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=next_portal
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Redis Configuration (matches docker-compose.full.yml redis service)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_DB=1
REDIS_TLS=false

# Backstage Configuration
BACKSTAGE_FRONTEND_URL=http://localhost:4401
BACKSTAGE_BACKEND_URL=http://localhost:4402
BACKSTAGE_FRONTEND_PORT=4401
BACKSTAGE_BACKEND_PORT=4402
BACKSTAGE_API_TOKEN=
BACKSTAGE_API_URL=http://localhost:4402

# Authentication Configuration
NEXTAUTH_URL=http://localhost:4400
NEXTAUTH_SECRET=development-nextauth-secret-min-32-chars-long
JWT_SECRET=development-jwt-secret-key-32-chars-minimum-required-here
JWT_EXPIRES_IN=7d
SESSION_SECRET=development-session-secret-32-chars-minimum-required
SESSION_MAX_AGE=604800000
ENCRYPTION_KEY=dev-encryption-key-32-chars-min!

# OAuth Providers (set in local .env.local — not committed)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing (Stripe test placeholders — replace in .env.local)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# Observability
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=
GRAFANA_ENABLED=false
PROMETHEUS_URL=http://localhost:9090

# CORS
CORS_ORIGIN=http://localhost:4400
CORS_ORIGINS=http://localhost:3000,http://localhost:4400

# Cloud Provider APIs for Cost Tracking (optional in development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_COST_EXPLORER_ENABLED=false

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_COST_MANAGEMENT_ENABLED=false

GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_BILLING_ACCOUNT_ID=
GCP_CLOUD_BILLING_ENABLED=false

# Feature Flags
ENABLE_COST_TRACKING=true
ENABLE_HEALTH_MONITORING=true
ENABLE_TEMPLATE_SYSTEM=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_DEV_FEATURES=true
DEBUG_MODE=true
USE_MOCK_DB=false
USE_MOCK_DATA=false
